# Server
PORT=3000

# CORS: frontend origin
FRONTEND_URL=http://localhost:5173

# Clinic time zone for appointment dates (optional, defaults to Europe/Warsaw)
# CLINIC_TIMEZONE=Europe/Warsaw

# Number of proxies in front of the API, so rate limiting sees the client's IP (optional).
# Leave unset when the API is reached directly.
# TRUST_PROXY=1

# Logging
NODE_ENV=development
LOG_LEVEL=debug

# JWT secrets, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_long_random_hex
JWT_REFRESH_SECRET=replace_me_with_another_long_random_hex
